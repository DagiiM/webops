# WebOps Platform Configuration
# Generated by install.sh on Sat Feb 21 19:56:53 UTC 2026

# Platform Configuration
WEBOPS_PLATFORM_DIR=/webops/provisioning

# System Configuration
WEBOPS_USER=webops
WEBOPS_ROOT=/webops
CONTROL_PANEL_DIR=/webops/control-panel
DEPLOYMENTS_DIR=/webops/deployments
SHARED_DIR=/webops/shared
BACKUPS_DIR=/webops/backups
WEBOPS_DATA_DIR=/webops/data
WEBOPS_LOG_DIR=/var/log/webops
WEBOPS_RUN_DIR=/var/run/webops

# Database Configuration
POSTGRES_ENABLED=true
POSTGRES_VERSION=14
POSTGRES_DATA_DIR=/webops/postgresql/data

# Control Panel Configuration
CONTROL_PANEL_ENABLED=true
CONTROL_PANEL_PORT=8000
CONTROL_PANEL_HOST=0.0.0.0

# Monitoring Configuration
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Security Configuration
ENABLE_FIREWALL=true
ENABLE_FAIL2BAN=true
ENABLE_AUTO_UPDATES=false

# SSH Security Configuration
# Set ENABLE_SSH_HARDENING=false to skip SSH hardening entirely
ENABLE_SSH_HARDENING=false
# Normal installation keeps SSH untouched; two explicit flags are required to change it.
SSH_ACCESS_CHANGE_CONFIRMED=false
# Root login options: no, yes, prohibit-password, forced-commands-only
PERMIT_ROOT_LOGIN=prohibit-password
# Password authentication (set to no to require SSH keys only)
SSH_PASSWORD_AUTH=no
# Maximum authentication attempts before disconnect
SSH_MAX_AUTH_TRIES=3

# Feature Flags
ENABLE_KUBERNETES=false
ENABLE_KVM=false
ENABLE_PATRONI=false
